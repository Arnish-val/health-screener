# ── Google OAuth Configuration ──────────────────────────────────────────────
# Obtain these from the Google Cloud Console (APIs & Services -> Credentials).
# Ensure Authorized JavaScript Origins matches your dev frontend port (e.g., http://localhost:5173).

# Backend configuration (used to verify the audience of incoming ID tokens)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend configuration (used to render the Google sign-in button)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── General Configuration ───────────────────────────────────────────────────
# Application Secret Key for JWT encoding (generate a secure random string)
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# Local Database URL (leave empty/commented out to use default SQLite)
# DATABASE_URL=sqlite:///./health_screener.db
